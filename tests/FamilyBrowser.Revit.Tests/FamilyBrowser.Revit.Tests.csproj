<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Configurations>Debug;Release</Configurations>
    <RevitVersion>2026</RevitVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="ricaun.RevitTest.TestAdapter" Version="1.11.1" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Always launch a separate Revit and close it: the user keeps other Revit 2026 instances open. -->
    <AssemblyMetadata Include="NUnit.Open" Value="true" />
    <AssemblyMetadata Include="NUnit.Close" Value="true" />
    <AssemblyMetadata Include="NUnit.Version" Value="$(RevitVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="..\..\src\FamilyBrowser.Revit\FamilyBrowser.Revit.csproj" />
    <ProjectReference Include="..\..\src\FamilyBrowser.Core\FamilyBrowser.Core.csproj" />
  </ItemGroup>

</Project>
